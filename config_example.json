{
  "// 基本设置": "注释：这是一个示例配置文件",
  "task_type": "LDA",
  "max_iterations": 50,
  "max_time_hours": 24,
  "random_seed": 42,
  
  "// 优化设置": "配置贝叶斯优化的核心参数",
  "acquisition_function": "EI",
  "acquisition_params": {
    "xi": 0.01
  },
  "objectives": ["AUROC"],
  "objective_weights": null,
  
  "// 多目标优化示例": "取消注释以启用多目标优化",
  "_objectives_multi": ["AUROC", "AUPRC", "F1"],
  "_objective_weights_multi": {
    "AUROC": 0.5,
    "AUPRC": 0.3,
    "F1": 0.2
  },
  "_maximize_auroc": true,
  "_maximize_auprc": true,
  "_maximize_f1": true,
  
  "// 数据设置": "数据路径和交叉验证配置",
  "data_path": null,
  "cv_folds": 5,
  
  "// 状态管理": "检查点和恢复设置",
  "checkpoint_dir": "checkpoints",
  "save_frequency": 1,
  "resume": false,
  "checkpoint_name": "latest",
  
  "// 收敛设置": "优化停止条件",
  "convergence_threshold": 0.001,
  
  "// 输出设置": "结果保存和报告生成",
  "output_dir": "results",
  "log_dir": "logs",
  "generate_report": true,
  "generate_html": true,
  "generate_charts": true,
  
  "// 高级设置": "专家用户配置",
  "gaussian_process_params": {
    "kernel": "matern52",
    "alpha": 1e-6,
    "n_restarts_optimizer": 10
  },
  
  "// 任务特定设置": "不同任务类型的特殊配置",
  "task_specific": {
    "LDA": {
      "primary_metric": "AUROC",
      "early_stopping_patience": 10
    },
    "MDA": {
      "primary_metric": "AUPRC",
      "early_stopping_patience": 15
    },
    "LMI": {
      "primary_metric": "F1",
      "early_stopping_patience": 12
    }
  }
}